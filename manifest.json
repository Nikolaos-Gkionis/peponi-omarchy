{
  "schemaVersion": 1,
  "id": "peponi.one-day",
  "name": "Peponi One Day",
  "version": "0.4.0",
  "author": "nikolaos",
  "license": "MIT",
  "description": "Focused one-day task view for Omarchy \u2014 use locally on this machine, or sync with a paid peponi.to account",
  "homepage": "https://peponi.to",
  "repository": "https://github.com/Nikolaos-Gkionis/peponi-omarchy",
  "keywords": [
    "tasks",
    "todo",
    "peponi",
    "focus",
    "one-day",
    "omarchy"
  ],
  "kinds": [
    "service",
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "qml/Service.qml",
    "overlay": "qml/Overlay.qml",
    "barWidget": "qml/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Peponi",
    "description": "Open the Peponi one-day focus overlay",
    "category": "Productivity",
    "aliases": [
      "peponi",
      "tasks",
      "todo",
      "one-day"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
